# ── Production environment (Render) ──────────────────────────────────────────
ENV=production
FLASK_DEBUG=0
FLASK_ENV=production

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# Render PostgreSQL internal URL — set automatically via render.yaml
DATABASE_URL=postgresql://user:password@host/dbname

# Your deployed frontend URL (no trailing slash)
ALLOWED_ORIGINS=https://buycars-frontend.onrender.com

# PORT is injected by Render automatically — do not set here
