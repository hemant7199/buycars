# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Strong random secret key for JWT signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_very_secret_key_here_change_this

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (local dev only)
# Set to your PostgreSQL URL for production:
#   postgresql://user:password@host/dbname
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
# Production: ALLOWED_ORIGINS=https://your-frontend.onrender.com

# ── FLASK ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1

# ── REDIS CACHE (optional) ────────────────────────────────────────────────────
# Leave blank to run without caching (graceful fallback)
# Local:      REDIS_URL=redis://localhost:6379/0
# Production: REDIS_URL=redis://red-xxxxx:6379  (Render Redis URL)
REDIS_URL=

# Cache TTL in seconds (optional, defaults shown)
# CACHE_TTL_SEARCH=60
# CACHE_TTL_STATS=120
# CACHE_TTL_OEM=300

# ── SENTRY (error monitoring, optional) ───────────────────────────────────────
# Leave blank to disable. Get your DSN from https://sentry.io
# Create project → Settings → Client Keys → DSN
SENTRY_DSN=

# ── PORT (set automatically by Render — do not set in production) ─────────────
# PORT=5000
